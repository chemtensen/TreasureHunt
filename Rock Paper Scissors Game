import random

rock = '''
    _______
---'   ____)
      (_____)
      (_____)
      (____)
---.__(___)
'''

paper = '''
    _______
---'   ____)____
          ______)
          _______)
         _______)
---.__________)
'''

scissors = '''
    _______
---'   ____)____
          ______)
       __________)
      (____)
---.__(___)
'''
game_images = [rock, paper, scissors]
choice = int(input("Lets play rock, paper, scissors. Choose 1 for rock, 2 for paper, 3 for scissors.\n"))

if choice >= 1 and choice <= 3:
    print(game_images[choice - 1])

computer_choice = random.randint(1, 3)
print("Computer chose:")
print(game_images[computer_choice - 1])

if choice >= 4 or choice < 1:
    print("Lizard or Spock are not choices here, you lose")
elif choice == 1 and computer_choice == 3:
    print("You win!")
elif computer_choice == 1 and choice == 3:
    print("You lose!")
elif computer_choice > choice:
    print("You lose!")
elif choice > computer_choice:
    print("You win!")
elif computer_choice == choice:
    print("It's a draw!")
